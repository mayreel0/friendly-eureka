<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#F5F7F6">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Lechigo Recorder" android:textSize="24sp" android:textStyle="bold" android:padding="16dp" android:textColor="#182523" />
    <FrameLayout android:id="@+id/camera" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="#000000" android:minHeight="120dp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Opening camera" android:textSize="18sp" android:textColor="#182523" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/progress" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="0 points" android:textColor="#46564E" android:paddingTop="8dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/start" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Start recording" />
                <Button android:id="@+id/restart" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Restart" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <Button android:id="@+id/mark" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Mark landmark" />
                <Button android:id="@+id/finish" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Finish at restroom" />
            </LinearLayout>
            <Button android:id="@+id/export" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Export recording" />
            <Button android:id="@+id/settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Camera settings" android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
