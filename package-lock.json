{
  "name": "lechigo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "lechigo",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=24"
      }
    },
    "apps/api": {
      "name": "@lechigo/api"
    },
    "apps/guest-webxr": {
      "name": "@lechigo/guest-webxr"
    },
    "apps/merchant-admin": {
      "name": "@lechigo/merchant-admin"
    },
    "node_modules/@lechigo/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@lechigo/config": {
      "resolved": "packages/config",
      "link": true
    },
    "node_modules/@lechigo/guest-webxr": {
      "resolved": "apps/guest-webxr",
      "link": true
    },
    "node_modules/@lechigo/merchant-admin": {
      "resolved": "apps/merchant-admin",
      "link": true
    },
    "node_modules/@lechigo/route-core": {
      "resolved": "packages/route-core",
      "link": true
    },
    "node_modules/@lechigo/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "packages/config": {
      "name": "@lechigo/config"
    },
    "packages/route-core": {
      "name": "@lechigo/route-core"
    },
    "packages/ui": {
      "name": "@lechigo/ui"
    }
  }
}
